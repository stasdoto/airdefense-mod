{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:display_context",
  "cases": [
   {
    "when": [
     "gui"
    ],
    "model": {
     "type": "minecraft:model",
     "model": "airdefense:item/asval_icon"
    }
   },
   {
    "when": [
     "ground",
     "fixed"
    ],
    "model": {
     "type": "minecraft:model",
     "model": "airdefense:item/asval"
    }
   }
  ],
  "fallback": {
   "type": "minecraft:condition",
   "property": "minecraft:using_item",
   "on_true": {
    "type": "minecraft:model",
    "model": "airdefense:item/asval_aim"
   },
   "on_false": {
    "type": "minecraft:model",
    "model": "airdefense:item/asval"
   }
  }
 }
}