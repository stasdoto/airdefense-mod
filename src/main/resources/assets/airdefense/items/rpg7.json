{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "airdefense:item/rpg7_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "airdefense:ammo",
      "on_true": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:model",
          "model": "airdefense:item/rpg7_aim"
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "airdefense:item/rpg7"
        }
      },
      "on_false": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:model",
          "model": "airdefense:item/rpg7_aim_empty"
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "airdefense:item/rpg7_empty"
        }
      }
    }
  }
}